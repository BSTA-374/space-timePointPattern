setwd("~/teaching/bsta374/space-timePointPattern")
#| label: setup
#| code-fold: false
library(sf)
library(dplyr)
library(ggplot2)
library(spatstat)
library(terra)
library(leaflet)
theme_set(theme_minimal(base_size = 12))
set.seed(374)
#| label: fig-three
#| fig-cap: "Three patterns, same window, same expected count: clustered (Thomas process), CSR, and regular (sequential inhibition)."
#| fig-width: 10
#| fig-height: 3.6
win <- owin(c(0, 1), c(0, 1))
pp_clus <- rThomas(kappa = 15, scale = 0.03, mu = 13, win = win)
pp_csr  <- rpoispp(lambda = 200, win = win)
pp_reg  <- rSSI(r = 0.055, n = 200, win = win)
par(mfrow = c(1, 3), mar = c(1, 1, 2, 1))
plot(pp_clus, main = "Clustered", pch = 16, cex = 0.6, cols = "firebrick")
plot(pp_csr,  main = "Random (CSR)", pch = 16, cex = 0.6, cols = "grey30")
plot(pp_reg,  main = "Regular", pch = 16, cex = 0.6, cols = "steelblue")
#| label: read-csv
#| code-fold: false
csv_path <- "phl_311_2024_subset.csv"
calls_raw <- read.csv(csv_path, stringsAsFactors = FALSE)
dim(calls_raw)
str(calls_raw)
#| label: inspect
#| code-fold: false
colSums(is.na(calls_raw[, c("lat", "lon")]))
sum(calls_raw$lat == 0 | calls_raw$lon == 0, na.rm = TRUE)   # null island
sum(duplicated(calls_raw[, c("lat", "lon", "service_name")]))
range(calls_raw$lat, na.rm = TRUE)
range(calls_raw$lon, na.rm = TRUE)
#| label: clean
#| code-fold: false
calls <- calls_raw |>
filter(!is.na(lat), !is.na(lon), lat != 0, lon != 0) |>
filter(between(lat, 39.8, 40.2), between(lon, -75.35, -74.9)) |>   # drops swapped pairs
mutate(requested_datetime = as.POSIXct(requested_datetime, tz = "America/New_York"))
nrow(calls_raw) - nrow(calls)
table(calls$service_name)
#| label: to-sf
#| code-fold: false
dump <- calls |>
filter(service_name == "Illegal Dumping") |>
st_as_sf(coords = c("lon", "lat"), crs = 4326) |>   # x then y
st_transform(32618)                                  # UTM 18N, metres
dump
#| label: boundary
#| code-fold: false
phl <- tigris::counties(state = "PA", cb = TRUE, year = 2022, progress_bar = FALSE) |>
filter(NAME == "Philadelphia") |>
st_transform(32618) |>
st_geometry()
dump <- dump[st_within(dump, phl, sparse = FALSE)[, 1], ]
win_phl <- as.owin(phl)
pp_dump <- as.ppp(st_geometry(dump))
Window(pp_dump) <- win_phl
pp_dump <- unique(pp_dump)          # drop coincident events
pp_dump
intensity(pp_dump) * 1e6            # events per km^2
#| label: fig-map
#| fig-cap: "Illegal dumping requests. Semi-transparent symbols, because overplotting hides the density we are trying to judge."
#| fig-width: 6.5
#| fig-height: 7
ggplot() +
geom_sf(data = phl, fill = "grey97", colour = "grey50", linewidth = 0.3) +
geom_sf(data = dump, size = 0.7, alpha = 0.35, colour = "firebrick") +
labs(title = "311 illegal dumping requests", subtitle = "one year · UTM 18N") +
theme_void(base_size = 11)
#| label: fig-quadrat
#| fig-cap: "Counts in an 8 x 8 grid. Cells clipped by the boundary have smaller areas, which the test accounts for."
#| fig-width: 6.5
#| fig-height: 7
qc <- quadratcount(pp_dump, nx = 8, ny = 8)
plot(pp_dump, pch = 16, cex = 0.3, cols = "grey65", main = "")
plot(qc, add = TRUE, col = "firebrick", cex = 0.8)
#| label: vmr
#| code-fold: false
cnt <- as.vector(qc)
c(mean = mean(cnt), var = var(cnt), VMR = var(cnt) / mean(cnt))
quadrat.test(pp_dump, nx = 8, ny = 8)
#| label: nnd
#| code-fold: false
nnd    <- nndist(pp_dump)
lambda <- intensity(pp_dump)
d_exp  <- 0.5 / sqrt(lambda)        # CSR expectation
c(observed_m = mean(nnd), expected_m = d_exp, R = mean(nnd) / d_exp)
clarkevans.test(pp_dump, correction = "cdf", alternative = "clustered",
method = "MonteCarlo", nsim = 99)
